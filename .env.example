APP_NAME="Listora"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.listora.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Production logs structured JSON to stderr so the host's log search is
# queryable by field (level, channel, datetime, context.*).
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=debug

# MySQL 8.4. Local dev can point at sqlite instead â€” every migration is
# driver-guarded where it uses MySQL-only syntax.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=listora
DB_USERNAME=root
DB_PASSWORD=

# Session, queue, and cache sit on Redis in production. File-based defaults
# break under horizontal scaling: each container has its own filesystem, so
# sessions and locks would diverge across replicas.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_CACHE_DB=0

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@listora.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# There are deliberately no payment-gateway variables here.
#
# Listora takes no payment on the website. It holds no card details, no bank
# details, no merchant account, and no processor credentials â€” advertising
# plans are arranged with the owner directly, off the site. If you find
# yourself adding a gateway key here, the product changed and the schema,
# permission catalog, and support-chat prompt all need to change with it.
# ---------------------------------------------------------------------------

# Anthropic â€” powers the AI support chat. Unset = chat returns a graceful
# "temporarily unavailable" and the widget degrades rather than erroring.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Arize AX tracing (see config/tracing.php)
#
# Arize publishes no PHP integration, so tracing is hand-rolled on the
# OpenTelemetry PHP SDK against OpenInference semantic conventions. Both
# credentials must be set for any trace to be exported; with neither set the
# tracer is never built and every span helper is a no-op.
#
# ARIZE_SPACE_ID is the base64 Space ID, NOT the space name â€” find it with
# `ax spaces list`. Get an API key (a scoped service key is recommended for
# app use) from app.arize.com -> Settings -> API Keys.
# ---------------------------------------------------------------------------
ARIZE_TRACING_ENABLED=true
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=listora-support-chat

# Region is NOT assumed. The default below is the US cluster; switch it if
# your space lives elsewhere:
#   US      https://otlp.arize.com/v1/traces
#   EU      https://otlp.eu-west-1a.arize.com/v1/traces
#   Canada  https://otlp.ca-central-1a.arize.com/v1/traces
ARIZE_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1/traces

# Message bodies are the point of LLM tracing, but they are user-typed free
# text. Set false to keep span structure, timings, token counts and status
# while dropping the content.
# PHP-FPM ends the process at the end of a request, which can beat the batch
# processor's timer. Flushing per turn costs one export and is why traces
# arrive at all. Set false only under a long-lived worker (Octane).
ARIZE_FLUSH_AFTER_TURN=true

ARIZE_CAPTURE_CONTENT=true
ARIZE_MAX_VALUE_LENGTH=8000

# MaxMind GeoIP2 â€” IP geolocation for login security and tracking. Both unset
# falls back to Cloudflare headers, then to a no-op; no anomaly detection.
MAXMIND_MMDB_PATH=
MAXMIND_ANONYMOUS_MMDB_PATH=
GEOIP_DISABLE_CLOUDFLARE=false

# Ops Slack webhook. Unset = NoOpSlackNotifier so dev/CI run cleanly.
SLACK_OPS_WEBHOOK_URL=
